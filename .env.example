# OpenDots template: the UI opens in setup state until these fields are configured.
HOST=127.0.0.1
PORT=4310
# Everything OpenDots stores lives in Postgres. `npm run db` starts the
# Compose database this URL points at; Compose itself sets its own URL.
DATABASE_URL=postgres://opendots:opendots@127.0.0.1:5432/opendots
# POSTGRES_PASSWORD=opendots
# POSTGRES_PORT=5432
# Keep OWNER_ID stable: it owns the stored conversations.
OWNER_ID=opendots-owner
# npm run dev allows http://localhost:5173 and http://127.0.0.1:5173.
# APP_ORIGIN replaces these defaults with comma-separated exact origins.
# Include scheme, hostname and port; omit paths and trailing slashes.
# APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Required for an external HOST binding (24+ characters); enables local login too.
# OWNER_TOKEN=

# Sign in to Gmail, Outlook and Teams from a Dot's settings; see docs/CONNECTIONS.md.
# SECRETS_KEY encrypts saved sign-ins and is required once either provider is set.
# SECRETS_KEY=
# PUBLIC_URL=http://127.0.0.1:4310
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# Required: an OpenAI-compatible model.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Maximum duration for Dot turns and scheduled/background agent runs (milliseconds).
# AGENT_RUN_TIMEOUT_MS=90000
# Setup telemetry (setup steps only, never conversations) is on by default.
# See docs/TELEMETRY.md. Either flag below opts out:
# DO_NOT_TRACK=1
# COPILOTKIT_TELEMETRY_DISABLED=true
# Optional: a fixed installation identity instead of a random one.
# CPK_TELEMETRY_ID=

# Optional isolated read-only public-page browser for WEB_SEARCH_PROVIDER=browser.
BROWSER_URL=http://127.0.0.1:4311
BROWSER_SECRET=
BROWSER_HOST=127.0.0.1
BROWSER_PORT=4311
# Use the same random 24+ character secret in app/browser. All redirects are blocked.
# Supply canonical public URLs. Use the separate browser container for isolation.

# Optional public HTTPS for a container install without opening ports;
# see docs/SETUP.md#cloudflare-tunnel. Used by `--profile tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional connected apps through Composio; see docs/SETUP.md#composio.
COMPOSIO_API_KEY=

# Optional discovery: Jev (TypeSafe) decides which new mail and messages
# need you on accounts with discovery on; see docs/SETUP.md#discovery.
# Get a key from https://typesafe.ai. Discovery is inactive without it.
TYPESAFE_API_KEY=
# Lowest confidence that flags an item. Default 0.6.
DISCOVERY_THRESHOLD=
# Optional similar items: any OpenAI-compatible embeddings endpoint. A local
# model keeps mail text on this machine, for example Ollama:
#   EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
#   EMBEDDING_MODEL=nomic-embed-text
# Off when EMBEDDING_BASE_URL is empty. Changing the model re-embeds items.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Optional realtime speech; calls write into the Dot's conversation.
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=marin

# Optional Slack, over Socket Mode (no public address needed); see
# docs/SETUP.md#slack. Allowlist both the Slack workspace and explicit user IDs.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_TEAM_ID=
SLACK_USER_IDS=
# SLACK_DOT_ID= (defaults to the initial Dot)

# Optional persistent computers, one per Dot, using OpenBot services.
# See docs/COMPUTERS.md. Keep these two different random secrets on the server.
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
# Keep stable: the namespace identifies existing containers and persistent volumes.
COMPUTER_NAMESPACE=opendots
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=runsc
# ENGINE_SOCKET=/var/run/docker.sock

# Public-web provider. parallel (default), browser (URL-only), or disabled.
# Queries and selected URLs are sent to Parallel; sample mode makes no provider calls.
WEB_SEARCH_PROVIDER=parallel
# Optional Bearer key for production/higher limits; anonymous MCP supports light use.
PARALLEL_API_KEY=

# Optional mobile app push notifications; see mobile/README.md.
# Notifications go through Expo's push service to Apple/Google. By default they
# only say a Dot has an update; set true to include a short preview of the result.
# PUSH_PREVIEWS=false
# Required only if you enable "Enhanced push security" in your Expo project.
# EXPO_ACCESS_TOKEN=
